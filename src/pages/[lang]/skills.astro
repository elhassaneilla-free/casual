---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/common/Header.astro";
import Footer from "../../components/common/Footer.astro";
import Section from "../../components/common/Section.astro";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "fr" } }];
}

const { lang } = Astro.params;
const isFr = lang === "fr";
const title = isFr ? "Compétences" : "Skills";

// Categories translations
const catInfra = isFr
  ? "Administration Systèmes & Infra"
  : "Infrastructure & Systems";
const catNet = isFr ? "Réseaux & Sécurité" : "Network & Security";
const catDev = isFr ? "Administration & Développement" : "Administration & Dev";

// Soft Skills Title
const softTitle = isFr ? "Compétences Humaines" : "Soft Skills";
---

<Layout title={title} lang={lang}>
  <Header lang={lang} />

  <main class="pt-20">
    <!-- Intro Section -->
    <Section background="dark" class="text-white">
      <div class="max-w-4xl">
        <h1
          class="text-5xl font-bold font-heading mb-8 animate-fade-in text-white"
        >
          {title}
        </h1>
        <p
          class="text-xl text-indigo-100 leading-relaxed font-light animate-fade-in delay-100"
        >
          {
            isFr
              ? "Mon parcours dans le monde de l’informatique a été à la fois riche et agréable, me permettant d’acquérir au fil du temps un large éventail de compétences techniques et humaines. Chaque compétence n’a pas été accumulée mécaniquement, mais construite à travers l’apprentissage, l’expérimentation, la pratique et la résolution de problèmes réels. Ci-dessous, un aperçu structuré des compétences qui façonnent aujourd’hui ma manière de travailler et de penser."
              : '"My journey through the IT world has been both rich and enjoyable, allowing me to acquire a wide range of technical and soft skills over time. Each skill was not collected mechanically, but built through learning, experimentation, practice, and real-world problem solving. Below is a structured overview of the competencies that shape the way I work and think today."'
          }
        </p>
      </div>
    </Section>

    <!-- Technical Skills Section -->
    <Section background="white">
      <div class="space-y-16">
        <div>
          <div class="flex items-center gap-4 mb-8">
            <div
              class="h-10 w-10 rounded-full bg-[var(--color-primary)] flex items-center justify-center text-white"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
              </svg>
            </div>
            <h2
              class="text-3xl font-bold font-heading text-[var(--color-dark)]"
            >
              {isFr ? "Compétences Techniques" : "Technical Skills"}
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Infrastructure & Systems -->
            <div
              class="p-6 rounded-2xl bg-white border border-gray-100 shadow-sm hover:shadow-lg transition-all duration-300 group"
            >
              <div
                class="w-full h-40 flex items-center justify-center mb-6 bg-gray-50 rounded-xl overflow-hidden group-hover:bg-indigo-50 transition-colors"
              >
                <img
                  src="/inf.png"
                  alt="Infrastructure"
                  class="w-full h-full object-cover rounded-xl hover:scale-105 transition-transform duration-500"
                />
              </div>
              <h3
                class="text-xl font-bold text-[var(--color-primary)] mb-4 pb-2 border-b border-gray-100"
              >
                {catInfra}
              </h3>
              <ul class="space-y-3">
                <li class="flex items-center gap-2 text-gray-600">
                  <svg
                    class="w-5 h-5 text-indigo-500 flex-shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <span
                    >{
                      isFr
                        ? "Administration Windows & Linux"
                        : "Windows & Linux Admin"
                    }</span
                  >
                </li>
                <li class="flex items-center gap-2 text-gray-600">
                  <svg
                    class="w-5 h-5 text-indigo-500 flex-shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"
                    ></path>
                  </svg>
                  <span
                    >{
                      isFr
                        ? "Virtualisation (VMware Workstation & ESXi)"
                        : "Virtualization (VMware Workstation & ESXi)"
                    }</span
                  >
                </li>
                <li class="flex items-center gap-2 text-gray-600">
                  <svg
                    class="w-5 h-5 text-indigo-500 flex-shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                    ></path>
                  </svg>
                  <span
                    >{
                      isFr
                        ? "Gestion de la téléphonie Grandstream"
                        : "Grandstream Telephony"
                    }</span
                  >
                </li>
              </ul>
            </div>

            <!-- Network & Security -->
            <div
              class="p-6 rounded-2xl bg-white border border-gray-100 shadow-sm hover:shadow-lg transition-all duration-300 group"
            >
              <div
                class="w-full h-40 flex items-center justify-center mb-6 bg-gray-50 rounded-xl overflow-hidden group-hover:bg-indigo-50 transition-colors"
              >
                <img
                  src="/net.png"
                  alt="Network"
                  class="w-full h-full object-cover rounded-xl hover:scale-105 transition-transform duration-500"
                />
              </div>
              <h3
                class="text-xl font-bold text-[var(--color-primary)] mb-4 pb-2 border-b border-gray-100"
              >
                {catNet}
              </h3>
              <ul class="space-y-3">
                <li class="flex items-center gap-2 text-gray-600">
                  <svg
                    class="w-5 h-5 text-indigo-500 flex-shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
                    ></path>
                  </svg>
                  <span>{isFr ? "Réseaux" : "Networking"}</span>
                </li>
                <li class="flex items-center gap-2 text-gray-600">
                  <svg
                    class="w-5 h-5 text-indigo-500 flex-shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"
                    ></path>
                  </svg>
                  <span
                    >{
                      isFr
                        ? "Gestion des équipements Cisco"
                        : "Cisco Devices Management"
                    }</span
                  >
                </li>
                <li class="flex items-center gap-2 text-gray-600">
                  <svg
                    class="w-5 h-5 text-indigo-500 flex-shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                    ></path>
                  </svg>
                  <span
                    >{
                      isFr
                        ? "Gestion des pare-feu WatchGuard"
                        : "WatchGuard Firewall"
                    }</span
                  >
                </li>
                <li class="flex items-center gap-2 text-gray-600">
                  <svg
                    class="w-5 h-5 text-indigo-500 flex-shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                    ></path>
                  </svg>
                  <span>{isFr ? "Sécurité informatique" : "IT Security"}</span>
                </li>
              </ul>
            </div>

            <!-- Admin & Dev -->
            <div
              class="p-6 rounded-2xl bg-white border border-gray-100 shadow-sm hover:shadow-lg transition-all duration-300 group"
            >
              <div
                class="w-full h-40 flex items-center justify-center mb-6 bg-gray-50 rounded-xl overflow-hidden group-hover:bg-indigo-50 transition-colors"
              >
                <img
                  src="/dev.png"
                  alt="Development"
                  class="w-full h-full object-cover rounded-xl hover:scale-105 transition-transform duration-500"
                />
              </div>
              <h3
                class="text-xl font-bold text-[var(--color-primary)] mb-4 pb-2 border-b border-gray-100"
              >
                {catDev}
              </h3>
              <ul class="space-y-3">
                <li class="flex items-center gap-2 text-gray-600">
                  <svg
                    class="w-5 h-5 text-indigo-500 flex-shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                    ></path>
                  </svg>
                  <span
                    >{
                      isFr
                        ? "Administration Microsoft 365"
                        : "M365 Admin Center"
                    }</span
                  >
                </li>
                <li class="flex items-center gap-2 text-gray-600">
                  <svg
                    class="w-5 h-5 text-indigo-500 flex-shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                    ></path>
                  </svg>
                  <span
                    >{
                      isFr
                        ? "Administration SAP & SAGE Paie"
                        : "SAP & SAGE Paie Admin"
                    }</span
                  >
                </li>
                <li class="flex items-center gap-2 text-gray-600">
                  <svg
                    class="w-5 h-5 text-indigo-500 flex-shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
                  </svg>
                  <span
                    >{
                      isFr
                        ? "Développement Front-end (Angular, HTML, CSS, JS/TS)"
                        : "Front-end Dev (Angular, HTML, CSS, JS/TS)"
                    }</span
                  >
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Soft Skills Section -->
        <div>
          <div class="flex items-center gap-4 mb-8">
            <div
              class="h-10 w-10 rounded-full bg-[var(--color-secondary)] flex items-center justify-center text-[var(--color-dark)] text-xl"
            >
              <!-- User Group SVG Icon -->
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                ></path>
              </svg>
            </div>
            <h2
              class="text-3xl font-bold font-heading text-[var(--color-dark)]"
            >
              {softTitle}
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Languages -->
            <div
              class="p-8 rounded-2xl bg-gradient-to-br from-gray-50 to-white border border-gray-100"
            >
              <h3 class="text-xl font-bold text-[var(--color-dark)] mb-6">
                {isFr ? "Langues" : "Languages"}
              </h3>
              <div class="space-y-4">
                <div>
                  <div class="flex justify-between mb-1">
                    <span class="font-medium text-gray-700"
                      >{isFr ? "Arabe" : "Arabic"}</span
                    >
                    <span class="text-sm text-gray-500"
                      >{isFr ? "Natif" : "Native"}</span
                    >
                  </div>
                  <div class="w-full bg-gray-200 rounded-full h-2">
                    <div
                      class="bg-green-500 h-2 rounded-full"
                      style="width: 100%"
                    >
                    </div>
                  </div>
                </div>
                <div>
                  <div class="flex justify-between mb-1">
                    <span class="font-medium text-gray-700"
                      >{isFr ? "Anglais" : "English"}</span
                    >
                    <span class="text-sm text-gray-500"
                      >{isFr ? "Courant" : "Fluent"}</span
                    >
                  </div>
                  <div class="w-full bg-gray-200 rounded-full h-2">
                    <div
                      class="bg-blue-500 h-2 rounded-full"
                      style="width: 100%"
                    >
                    </div>
                  </div>
                </div>
                <div>
                  <div class="flex justify-between mb-1">
                    <span class="font-medium text-gray-700"
                      >{isFr ? "Français" : "French"}</span
                    >
                    <span class="text-sm text-gray-500"
                      >{isFr ? "Intermédiaire" : "Intermediate"}</span
                    >
                  </div>
                  <div class="w-full bg-gray-200 rounded-full h-2">
                    <div
                      class="bg-yellow-500 h-2 rounded-full"
                      style="width: 70%"
                    >
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Professional Qualities -->
            <div class="grid grid-cols-2 gap-4">
              <div
                class="p-6 rounded-2xl bg-white border border-gray-100 shadow-sm flex flex-col items-center justify-center text-center hover:-translate-y-1 transition-transform duration-300"
              >
                <svg
                  class="w-10 h-10 text-[var(--color-primary)] mb-3"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
                  ></path>
                </svg>
                <div class="font-bold text-gray-800">
                  {isFr ? "Communication claire" : "Clear Communication"}
                </div>
              </div>
              <div
                class="p-6 rounded-2xl bg-white border border-gray-100 shadow-sm flex flex-col items-center justify-center text-center hover:-translate-y-1 transition-transform duration-300"
              >
                <svg
                  class="w-10 h-10 text-[var(--color-primary)] mb-3"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                  ></path>
                </svg>
                <div class="font-bold text-gray-800">
                  {isFr ? "Stratégie IT" : "IT Strategy"}
                </div>
              </div>
              <div
                class="p-6 rounded-2xl bg-white border border-gray-100 shadow-sm flex flex-col items-center justify-center text-center hover:-translate-y-1 transition-transform duration-300"
              >
                <svg
                  class="w-10 h-10 text-[var(--color-primary)] mb-3"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
                <div class="font-bold text-gray-800">
                  {isFr ? "Autonomie" : "Autonomy"}
                </div>
              </div>
              <div
                class="p-6 rounded-2xl bg-white border border-gray-100 shadow-sm flex flex-col items-center justify-center text-center hover:-translate-y-1 transition-transform duration-300"
              >
                <svg
                  class="w-10 h-10 text-[var(--color-primary)] mb-3"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v2a7.5 7.5 0 0015 0v-5a1.5 1.5 0 00-3 0m-6-3V11m0-5.5v-1a1.5 1.5 0 013 0v1m0 0V11m0-5.5a1.5 1.5 0 013 0v3m0 0V11"
                  ></path>
                </svg>
                <div class="font-bold text-gray-800">
                  {isFr ? "Travail en équipe" : "Teamwork"}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Section>
  </main>

  <Footer lang={lang} />
</Layout>
