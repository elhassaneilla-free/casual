// Duplicate items to ensure uninterrupted seamless scrolling on all screen resolutions (up to 4K)
const sequence = [...technologies, ...technologies];
---

<section
  class="relative z-20 py-4 md:py-5 mb-10 md:mb-14 overflow-hidden bg-slate-900/90 border-y border-white/10 backdrop-blur-md transition-colors"
  aria-label={isFr ? "Technologies clés" : "Core Technologies"}
>
  <!-- Edge Gradient Masks for Smooth Dissolve -->
  <div
    class="pointer-events-none absolute left-0 top-0 bottom-0 w-12 md:w-28 bg-gradient-to-r from-slate-900 to-transparent z-10"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute right-0 top-0 bottom-0 w-12 md:w-28 bg-gradient-to-l from-slate-900 to-transparent z-10"
    aria-hidden="true"
  >
  </div>

  <!-- Marquee Container -->
  <div class="marquee-container flex overflow-hidden select-none">
    <div class="marquee-track flex items-center shrink-0">
      <!-- First Half -->
      <div class="marquee-group flex items-center gap-3 md:gap-5 px-1.5 md:px-2.5 shrink-0">
        {
          sequence.map((tech) => (
            <div class="tech-card flex items-center gap-2.5 md:gap-3 px-3.5 py-2 md:px-5 md:py-2.5 rounded-xl bg-white/[0.05] hover:bg-white/[0.09] border border-white/10 backdrop-blur-md shadow-sm shrink-0 transition-all duration-300 hover:border-white/25 hover:scale-105">
              <div class="shrink-0 flex items-center justify-center" set:html={tech.icon} />
              <div class="flex flex-col text-left">
                <span class="text-xs md:text-sm font-bold tracking-tight text-white font-heading whitespace-nowrap">
                  {tech.name}
                </span>
                <span class="text-[9px] md:text-[10px] uppercase font-semibold tracking-wider text-indigo-200/70 whitespace-nowrap">
                  {tech.category}
                </span>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Second Half (Exact Duplicate for Seamless 0% to -50% Loop) -->
      <div class="marquee-group flex items-center gap-3 md:gap-5 px-1.5 md:px-2.5 shrink-0" aria-hidden="true">
        {
          sequence.map((tech) => (
            <div class="tech-card flex items-center gap-2.5 md:gap-3 px-3.5 py-2 md:px-5 md:py-2.5 rounded-xl bg-white/[0.05] hover:bg-white/[0.09] border border-white/10 backdrop-blur-md shadow-sm shrink-0 transition-all duration-300 hover:border-white/25 hover:scale-105">
              <div class="shrink-0 flex items-center justify-center" set:html={tech.icon} />
              <div class="flex flex-col text-left">
                <span class="text-xs md:text-sm font-bold tracking-tight text-white font-heading whitespace-nowrap">
                  {tech.name}
                </span>
                <span class="text-[9px] md:text-[10px] uppercase font-semibold tracking-wider text-indigo-200/70 whitespace-nowrap">
                  {tech.category}
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-container {
    mask-image: linear-gradient(
      to right,
      transparent,
      black 8%,
      black 92%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 8%,
      black 92%,
      transparent
    );
  }

  .marquee-track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: marquee-scroll 32s linear infinite;
  }

  /* Pause on hover on desktop */
  .marquee-container:hover .marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* Accessibility: Respect users with reduced motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none !important;
      transform: none !important;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
    }
    .marquee-container {
      mask-image: none;
      -webkit-mask-image: none;
    }
  }
</style>
