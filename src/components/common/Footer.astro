---
interface Props {
  lang: string;
}
const { lang } = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-50 border-t border-gray-100 pt-16 pb-8">
  <div class="container-custom">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
      <div class="col-span-1 md:col-span-2">
        <h3
          class="text-2xl font-bold font-heading text-[var(--color-dark)] mb-4"
        >
          EL HASSANE<span class="text-[var(--color-primary)]">ILLA</span>
        </h3>
        <p class="text-gray-500 max-w-sm mb-6">
          {
            lang === "fr"
              ? "Conception d'expériences numériques modernes, performantes et accessibles."
              : "Crafting modern, high-performance, and accessible digital experiences."
          }
        </p>
        <div class="flex gap-4">
          <!-- Social Placeholders -->
          <a
            href="https://wa.me/212708402942"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-white shadow-sm flex items-center justify-center text-gray-500 hover:bg-[#25D366] hover:text-white transition-all"
          >
            <span class="sr-only">WhatsApp</span>
            <svg
              class="h-5 w-5"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
              ></path>
            </svg>
          </a>
          <a
            href="https://www.linkedin.com/in/el-hassane-illa-5b7129295/"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-white shadow-sm flex items-center justify-center text-gray-500 hover:bg-[#0077b5] hover:text-white transition-all"
          >
            <span class="sr-only">LinkedIn</span>
            <svg
              class="h-5 w-5"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
              ><path
                fill-rule="evenodd"
                d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
                clip-rule="evenodd"></path></svg
            >
          </a>
          <a
            href="mailto:elhassaneilla@gmail.com"
            class="w-10 h-10 rounded-full bg-white shadow-sm flex items-center justify-center text-gray-500 hover:bg-[#EA4335] hover:text-white transition-all"
            aria-label="Email"
          >
            <span class="sr-only">Email</span>
            <svg
              class="h-5 w-5"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-2.023 2.309-3.178 3.927-1.964L5.455 4.64 12 9.548l6.545-4.91 1.528-1.145C21.69 2.28 24 3.434 24 5.457z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <div>
        <h4 class="font-bold text-[var(--color-dark)] mb-4">
          {lang === "fr" ? "Navigation" : "Navigation"}
        </h4>
        <ul class="space-y-2">
          <li>
            <a
              href={`/${lang}`}
              class="text-sm text-gray-500 hover:text-[var(--color-primary)]"
              >Home</a
            >
          </li>
          <li>
            <a
              href={`/${lang}/about`}
              class="text-sm text-gray-500 hover:text-[var(--color-primary)]"
              >About</a
            >
          </li>
          <li>
            <a
              href={`/${lang}/projects`}
              class="text-sm text-gray-500 hover:text-[var(--color-primary)]"
              >Projects</a
            >
          </li>
        </ul>
      </div>

      <div>
        <h4 class="font-bold text-[var(--color-dark)] mb-4">
          {lang === "fr" ? "Contact" : "Contact"}
        </h4>
        <ul class="space-y-2">
          <li class="text-sm text-gray-500">elhassaneilla@gmail.com</li>
          <li class="text-sm text-gray-500">+212708402942</li>
          <li class="text-sm text-gray-500">all over Morroco</li>
        </ul>
      </div>
    </div>

    <div
      class="border-t border-gray-200 pt-8 flex flex-col md:flex-row justify-between items-center gap-4"
    >
      <p class="text-sm text-gray-400">
        © {currentYear} EL HASSANE ILLA. {
          lang === "fr" ? "Tous droits réservés." : "All rights reserved."
        }
      </p>
      <p class="text-sm text-gray-400">designed by me.</p>
    </div>
  </div>
</footer>
